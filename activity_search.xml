<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0D0D0D">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:padding="8dp" android:gravity="center_vertical">
    <EditText android:id="@+id/editQuery" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textColor="#FFF" android:hint="Kya search karna hai..."
        android:textColorHint="#666" android:backgroundTint="#333" android:padding="10dp" android:inputType="text"/>
    <Button android:id="@+id/btnMic" android:layout_width="56dp" android:layout_height="48dp"
        android:layout_marginStart="6dp" android:text="Mic" android:backgroundTint="#00838F" android:textColor="#FFF" android:textSize="12sp"/>
    <Button android:id="@+id/btnSearch" android:layout_width="72dp" android:layout_height="48dp"
        android:layout_marginStart="6dp" android:text="Search" android:backgroundTint="#1565C0" android:textColor="#FFF" android:textSize="12sp"/>
  </LinearLayout>
  <WebView android:id="@+id/webView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
